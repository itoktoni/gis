meta {
  name: 03 Login User Baru
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/login
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
  }
}

script:post-response {
  bru.setVar("userToken", res.getBody().access_token);

  test("Login user baru sukses (200)", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Token user baru terbit", function() {
    expect(res.getBody().access_token).to.be.a("string");
  });
}
