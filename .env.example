APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# NOTIFICATION
NOTIFICATION_ENABLE=false

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=startok-app
PUSHER_APP_KEY=startok-key
PUSHER_APP_SECRET=startok-secret
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

PUSH_API_URL=
FRONTEND_URL=
SANCTUM_STATEFUL_DOMAINS=

PUSH_API_URL=
SANCTUM_STATEFUL_DOMAINS=

QRIS=
LANGKAHKECIL_TRIAL_DAYS=10
LANGKAHKECIL_PAYMENT_UNIC_DIGIT=2

AFFILIATE_REGISTER_BONUS=1000
AFFILIATE_UPGRADE_COMMISSION_RATE=23

VERIFICATION_REGISTER_BACKEND=false
VERIFICATION_REGISTER_FRONTEND=true
VERIFICATION_GATEWAY=whatsapp
BYPASS_EMAIL_VERIFICATION_WEB=false
BYPASS_EMAIL_VERIFICATION_API=false

# Fonnte WhatsApp (LHP reminder ke grup)
FONNTE_TOKEN=
FONNTE_LHP_GROUP_ID=
FONNTE_LHP_REMINDER_AT=12:00
FONNTE_COUNTRY_CODE=62

# WAJIB WIB — stempel jam di foto check-in memakai timezone ini
APP_TIMEZONE=Asia/Jakarta

# Batas akurasi GPS (meter). Di atas ini check-in tetap tersimpan
# tapi statusnya tidak VALID. Naikkan (mis. 200) bila area memang susah sinyal.
ABSEN_MAX_ACCURACY_M=100

# Pengingat check-in satpam (notifikasi lokal Android, diambil via /api/absensi/reminder-config)
# Contoh shift malam tiap 3 jam: START=18:00, END=06:00, INTERVAL=3, MAX=8
REMINDER_ENABLED=true
REMINDER_START=06:00
REMINDER_END=17:00
REMINDER_INTERVAL_HOURS=3
REMINDER_MAX_PER_DAY=8
REMINDER_TITLE="Waktunya Check-In"
REMINDER_MESSAGE="Segera buka aplikasi dan tekan FOTO untuk check-in."

# LHP: tampilkan panel UP & curah hujan di form (false = disembunyikan dulu)
LHP_UP_ENABLED=false
LHP_HUJAN_ENABLED=false

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CONTENT_NICHE="melatih soft skill dan life skill anak usia 1-10 tahun"

# Telegram Group (1 group, beda thread per platform)
TELEGRAM_GROUP_ID=
TELEGRAM_THREAD_INSTAGRAM=
TELEGRAM_THREAD_TIKTOK=
TELEGRAM_THREAD_THREADS=
TELEGRAM_THREAD_FACEBOOK=
TELEGRAM_THREAD_TELEGRAM=

# Scan Prefix (Forklift Pick)
SCAN_PREFIX_PALLET=P
SCAN_PREFIX_LOCATION=L
SCAN_PREFIX_BARCODE=B

# Bluetooth Printer
PRINTER_TYPE=receipt
PRINTER_PAPER_WIDTH=58
PRINTER_CUT=true
PRINTER_BEEP=false
PRINTER_LABEL_WIDTH=40
PRINTER_LABEL_HEIGHT=30
PRINTER_LABEL_GAP=2
PRINTER_LABEL_COPIES=1
PRINTER_LABEL_FORMAT=escpos
PRINTER_AUTO_CONNECT=true
PRINTER_MAC=

# AI / LLM (OpenAI-compatible) — untuk jawaban Tanya KMS
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=MiniMax-M2.7-highspeed

# Knowledge Management System
KMS_CHUNK_SIZE=1200
KMS_CHUNK_OVERLAP=150
KMS_TOP_K=5
KMS_MAX_CONTEXT_CHARS=12000

