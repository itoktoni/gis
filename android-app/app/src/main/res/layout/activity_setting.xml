<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/apn_bg">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipe"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <TextView
                android:text="⚙️ Setting Server"
                android:textSize="20sp" android:textStyle="bold"
                android:textColor="@color/apn_text"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/APN.Card" app:cardElevation="2dp"
                app:strokeWidth="1.5dp" app:strokeColor="@color/apn_primary">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">

                    <TextView android:text="URL Server"
                        android:textSize="13sp" android:textStyle="bold"
                        android:textColor="@color/apn_text"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />

                    <EditText android:id="@+id/etServer"
                        android:hint="https://apnkalteng2.web.id/"
                        android:textSize="15sp" android:singleLine="true"
                        android:layout_marginTop="6dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />

                    <TextView android:id="@+id/tvResult"
                        android:textSize="13sp"
                        android:textColor="@color/apn_text_muted"
                        android:layout_marginTop="8dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:weightSum="2"
                        android:layout_width="match_parent" android:layout_height="wrap_content">

                        <Button android:id="@+id/btnTest" android:text="🔍 TES"
                            style="@style/APN.Button.Outlined"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:layout_width="0dp" android:layout_height="56dp" />

                        <Button android:id="@+id/btnSaveServer" android:text="💾 SIMPAN"
                            style="@style/APN.Button.Primary"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_width="0dp" android:layout_height="56dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/APN.Card" app:cardElevation="2dp"
                app:strokeWidth="1.5dp" app:strokeColor="@color/apn_primary"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">

                    <TextView android:text="🔔 Pengingat Check-In"
                        android:textSize="17sp" android:textStyle="bold"
                        android:textColor="@color/apn_text"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />

                    <TextView android:id="@+id/tvReminderInfo"
                        android:text="Memuat..."
                        android:textSize="13sp"
                        android:textColor="@color/apn_text_muted"
                        android:layout_marginTop="6dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />

                    <CheckBox android:id="@+id/cbDisableReminder"
                        android:text="Matikan pengingat di HP ini"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />

                    <EditText android:id="@+id/etReminderInterval"
                        android:hint="Interval jam (cth: 3, 1, 0.5, 0.2)"
                        android:textSize="15sp" android:singleLine="true"
                        android:inputType="numberDecimal"
                        android:layout_marginTop="6dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:weightSum="2"
                        android:layout_width="match_parent" android:layout_height="wrap_content">

                        <Button android:id="@+id/btnSaveReminder" android:text="💾 SIMPAN"
                            style="@style/APN.Button.Primary"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:layout_width="0dp" android:layout_height="56dp" />

                        <Button android:id="@+id/btnTestNotif" android:text="🔔 TES NOTIF"
                            style="@style/APN.Button.Outlined"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_width="0dp" android:layout_height="56dp" />
                    </LinearLayout>

                    <TextView android:id="@+id/tvNotifStatus"
                        android:text="Mengecek izin notifikasi..."
                        android:textSize="13sp"
                        android:textColor="@color/apn_text_muted"
                        android:layout_marginTop="12dp"
                        android:layout_width="match_parent" android:layout_height="wrap_content" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Button android:id="@+id/btnLogoutSetting" android:text="🚪 LOGOUT"
                style="@style/APN.Button.Danger"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent" android:layout_height="56dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/APN.Card" app:cardElevation="2dp"
                app:strokeWidth="1.5dp" app:strokeColor="@color/apn_primary"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">

                    <TextView android:text="APN Monitoring"
                        android:textSize="17sp" android:textStyle="bold"
                        android:textColor="@color/apn_text"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />

                    <TextView android:id="@+id/tvAppVersion"
                        android:text="Versi -"
                        android:textSize="14sp"
                        android:textColor="@color/apn_text_muted"
                        android:layout_marginTop="6dp"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />

                    <Button android:id="@+id/btnCheckUpdate" android:text="⬇️ CEK UPDATE"
                        style="@style/APN.Button.Primary"
                        android:layout_marginTop="12dp"
                        android:layout_width="match_parent" android:layout_height="56dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include layout="@layout/bottom_bar" />
</LinearLayout>
