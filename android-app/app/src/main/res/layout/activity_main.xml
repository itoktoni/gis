<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/apn_bg">

    <!-- Konten (pull-to-refresh) -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipe"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <!-- Header brand -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/APN.Card"
                app:cardBackgroundColor="@color/apn_primary"
                app:cardElevation="0dp">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="48dp" android:layout_height="48dp"
                        android:src="@mipmap/ic_launcher"
                        android:background="@color/white"
                        android:padding="4dp" />

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_marginStart="12dp"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="APN Monitoring"
                            android:textSize="20sp" android:textStyle="bold"
                            android:textColor="@color/white"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tvUser"
                            android:text="Belum login"
                            android:textSize="12sp"
                            android:textColor="@color/apn_primary_light"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Form login -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/loginCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/APN.Card"
                android:layout_marginTop="14dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Email"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            android:inputType="textEmailAddress"
                            android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Password"
                        app:endIconMode="password_toggle"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPass"
                            android:inputType="textPassword"
                            android:layout_width="match_parent" android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button android:id="@+id/btnLogin" android:text="LOGIN"
                        style="@style/APN.Button.Primary"
                        android:layout_marginTop="14dp"
                        android:layout_width="match_parent" android:layout_height="56dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dashboard widget -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/dashCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                style="@style/APN.Card"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardElevation="2dp"
                app:strokeWidth="1.5dp" app:strokeColor="@color/apn_primary">

                <LinearLayout
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content">

                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="📊 Dashboard"
                            android:textSize="16sp" android:textStyle="bold"
                            android:textColor="@color/apn_text"
                            android:layout_width="0dp" android:layout_weight="1"
                            android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tvDashPeriod"
                            android:text="Hari ini"
                            android:textSize="11sp"
                            android:textColor="@color/apn_text_muted"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout android:orientation="horizontal"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">
                        <Button android:id="@+id/chipToday" android:text="HARI" style="@style/APN.Button.Primary"
                            android:textSize="11sp" android:minHeight="0dp"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
                            android:layout_marginEnd="3dp" />
                        <Button android:id="@+id/chipWeek" android:text="MGGU" style="@style/APN.Button.Outlined"
                            android:textSize="11sp" android:minHeight="0dp"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
                            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                        <Button android:id="@+id/chipMonth" android:text="BLN" style="@style/APN.Button.Outlined"
                            android:textSize="11sp" android:minHeight="0dp"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
                            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                        <Button android:id="@+id/chipYear" android:text="THN" style="@style/APN.Button.Outlined"
                            android:textSize="11sp" android:minHeight="0dp"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
                            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" />
                        <Button android:id="@+id/chipRange" android:text="TGL" style="@style/APN.Button.Outlined"
                            android:textSize="11sp" android:minHeight="0dp"
                            android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
                            android:layout_marginStart="3dp" />
                    </LinearLayout>

                    <GridLayout
                        android:columnCount="2"
                        android:alignmentMode="alignMargins"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp">

                        <LinearLayout android:orientation="vertical" android:gravity="center"
                            android:background="#E6F4EA" android:padding="10dp"
                            android:layout_width="0dp" android:layout_columnWeight="1"
                            android:layout_height="wrap_content" android:layout_margin="3dp">
                            <TextView android:id="@+id/tvStatValid" android:text="-"
                                android:textSize="24sp" android:textStyle="bold"
                                android:textColor="#1B7A3D"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            <TextView android:text="✅ Sesuai" android:textSize="11sp"
                                android:textColor="#1B7A3D"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout android:orientation="vertical" android:gravity="center"
                            android:background="#FEF3C7" android:padding="10dp"
                            android:layout_width="0dp" android:layout_columnWeight="1"
                            android:layout_height="wrap_content" android:layout_margin="3dp">
                            <TextView android:id="@+id/tvStatInvalid" android:text="-"
                                android:textSize="24sp" android:textStyle="bold"
                                android:textColor="#B45309"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            <TextView android:text="📍 Luar" android:textSize="11sp"
                                android:textColor="#B45309"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        </LinearLayout>

                        <LinearLayout android:orientation="vertical" android:gravity="center"
                            android:background="#E3F0FF" android:padding="10dp"
                            android:layout_width="0dp" android:layout_columnWeight="1"
                            android:layout_height="wrap_content" android:layout_margin="3dp">
                            <TextView android:id="@+id/tvStatVisit" android:text="-"
                                android:textSize="24sp" android:textStyle="bold"
                                android:textColor="#1E4FA8"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            <TextView android:text="📌 Titik" android:textSize="11sp"
                                android:textColor="#1E4FA8"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        </LinearLayout>
                        <LinearLayout android:id="@+id/statPendingBox"
                            android:orientation="vertical" android:gravity="center"
                            android:background="#F3E8FF" android:padding="10dp"
                            android:clickable="true" android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:layout_width="0dp" android:layout_columnWeight="1"
                            android:layout_height="wrap_content" android:layout_margin="3dp">
                            <TextView android:id="@+id/tvStatPending" android:text="0"
                                android:textSize="24sp" android:textStyle="bold"
                                android:textColor="#7C3AED"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            <TextView android:text="⏳ Pending" android:textSize="11sp"
                                android:textColor="#7C3AED"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Grid menu -->
            <GridLayout android:id="@+id/menuGrid"
                android:columnCount="2"
                android:rowCount="3"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardCheckin"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    style="@style/APN.Card" app:cardElevation="2dp"
                    app:strokeWidth="1.5dp" app:strokeColor="@color/apn_primary">
                    <LinearLayout android:orientation="vertical" android:gravity="center"
                        android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="📷" android:textSize="48sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:text="Check-In" android:textSize="17sp" android:textStyle="bold"
                            android:textColor="@color/apn_text" android:layout_marginTop="8dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:text="Foto + kirim kehadiran" android:textSize="11sp"
                            android:textColor="@color/apn_text_muted"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardVisit"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    style="@style/APN.Card" app:cardElevation="2dp"
                    app:strokeWidth="1.5dp" app:strokeColor="@color/apn_primary">
                    <LinearLayout android:orientation="vertical" android:gravity="center"
                        android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="📍" android:textSize="48sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:text="Titik Kunjungan" android:textSize="17sp" android:textStyle="bold"
                            android:textColor="@color/apn_text" android:layout_marginTop="8dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:text="Peta + rute kebun" android:textSize="11sp"
                            android:textColor="@color/apn_text_muted"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardReport"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    style="@style/APN.Card" app:cardElevation="2dp"
                    app:strokeWidth="1.5dp" app:strokeColor="@color/apn_primary">
                    <LinearLayout android:orientation="vertical" android:gravity="center"
                        android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="📋" android:textSize="48sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:text="Laporan" android:textSize="17sp" android:textStyle="bold"
                            android:textColor="@color/apn_text" android:layout_marginTop="8dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:text="Riwayat check-in" android:textSize="11sp"
                            android:textColor="@color/apn_text_muted"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardServer"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    style="@style/APN.Card" app:cardElevation="2dp"
                    app:strokeWidth="1.5dp" app:strokeColor="@color/apn_primary">
                    <LinearLayout android:orientation="vertical" android:gravity="center"
                        android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="⚙️" android:textSize="48sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:text="Server" android:textSize="17sp" android:textStyle="bold"
                            android:textColor="@color/apn_text" android:layout_marginTop="8dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:text="Atur alamat server" android:textSize="11sp"
                            android:textColor="@color/apn_text_muted"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardSync"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp"
                    android:clickable="true" android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    style="@style/APN.Card" app:cardElevation="2dp"
                    app:strokeWidth="1.5dp" app:strokeColor="@color/apn_primary"
                    android:visibility="gone">
                    <LinearLayout android:orientation="vertical" android:gravity="center"
                        android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <TextView android:text="🔄" android:textSize="48sp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:id="@+id/tvSyncLabel" android:text="Sync" android:textSize="17sp" android:textStyle="bold"
                            android:textColor="@color/apn_text" android:layout_marginTop="8dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        <TextView android:text="Kirim antrean offline" android:textSize="11sp"
                            android:textColor="@color/apn_text_muted"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <TextView android:id="@+id/tvInfo"
                android:textSize="12sp"
                android:textColor="@color/apn_text_muted"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include layout="@layout/bottom_bar" />
</LinearLayout>
