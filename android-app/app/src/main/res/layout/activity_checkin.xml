<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/apn_bg">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipe"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">

        <!-- Header -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <ImageView
                android:layout_width="40dp" android:layout_height="40dp"
                android:src="@mipmap/ic_launcher"
                android:background="@color/white"
                android:padding="2dp" />

            <TextView
                android:text="Check-In Lapangan"
                android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/apn_text"
                android:layout_marginStart="10dp"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Preview kamera -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent" android:layout_height="380dp"
            style="@style/APN.Card"
            android:layout_marginTop="8dp"
            app:cardElevation="4dp">

            <FrameLayout
                android:layout_width="match_parent" android:layout_height="match_parent">

                <androidx.camera.view.PreviewView
                    android:id="@+id/preview"
                    android:layout_width="match_parent" android:layout_height="match_parent" />

                <!-- Overlay template WYSIWYG: persis yang ditempel ke foto saat capture -->
                <ImageView android:id="@+id/ivPrevLogo"
                    android:src="@drawable/apn_logo"
                    android:layout_width="176dp" android:layout_height="52dp"
                    android:scaleType="fitCenter"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp" />

                <LinearLayout android:id="@+id/bannerPrev"
                    android:orientation="vertical"
                    android:background="#FF000000"
                    android:padding="10dp"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="bottom">

                    <TextView android:id="@+id/tvPrevDate"
                        android:textSize="16sp" android:textStyle="bold"
                        android:textColor="#FFD54F"
                        android:text="..."
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />

                    <TextView android:id="@+id/tvPrevAddr"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:maxLines="2" android:ellipsize="end"
                        android:text="-"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />

                    <TextView android:id="@+id/tvPrevCoord"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:text=""
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView android:id="@+id/tvStamp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="10dp" android:padding="8dp"
                    android:background="#CC1E4FA8" android:textColor="@color/white"
                    android:textSize="12sp" android:text="Mencari GPS..."
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:id="@+id/tvWarn"
            android:textSize="13sp"
            android:textColor="#B3261E"
            android:background="#FDECEA"
            android:padding="10dp"
            android:visibility="gone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <Button android:id="@+id/btnDevSettings" android:text="⚙ BUKA PENGATURAN DEVELOPER"
            style="@style/APN.Button.Outlined"
            android:visibility="gone"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent" android:layout_height="wrap_content">

            <Button android:id="@+id/btnLoc"
                android:text="📍 LOKASI"
                style="@style/APN.Button.Outlined"
                android:textSize="12sp"
                android:layout_width="wrap_content" android:layout_height="56dp"
                android:layout_marginEnd="8dp" />

            <Button android:id="@+id/btnCapture" android:text="📷 FOTO"
                style="@style/APN.Button.Primary"
                android:textSize="16sp"
                android:layout_weight="1"
                android:layout_width="0dp" android:layout_height="62dp" />

            <Button android:id="@+id/btnFlip"
                android:text="🔄 KAMERA"
                style="@style/APN.Button.Outlined"
                android:textSize="12sp"
                android:layout_width="wrap_content" android:layout_height="56dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView android:id="@+id/tvStatus"
            android:textSize="13sp"
            android:textColor="@color/apn_text_muted"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />
    </LinearLayout>
    </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include layout="@layout/bottom_bar" />

</LinearLayout>
